## 4. CẤU TRÚC THƯ MỤC DỰ ÁN
```
d:\WebNhaLam\
├── .gitignore              # Bỏ qua node_modules, dist, logs
├── .memory                 # File này: Tổng hợp tri thức dự án
├── implement_plan.md       # Bản kế hoạch thiết kế và thông số ban đầu
├── index.html              # Entry HTML, load Google Fonts tiếng Việt
├── package.json            # Scripts & dependencies
├── tailwind.config.js      # Cấu hình màu brand, font, keyframes
├── vite.config.js          # Cấu hình Vite React plugin
├── public/                 # Tài nguyên tĩnh trực tiếp
│   ├── menu.json           # Dữ liệu thực đơn nhà hàng (6 danh mục, hơn 60 món)
│   └── images/
│       ├── Logo/           # Logo Dốc Mơ (main_logo, main_logo-removebg-preview)
│       ├── foods/          # Kho ảnh món ăn thực tế (hơn 70 ảnh món chất lượng cao)
│       ├── KhongGian/      # Ảnh chụp không gian quán (khu gia đình, sân vườn ngoài trời)
│       └── banner-khuyen-mai/ # 10 poster combo/món mới/ưu đãi
└── src/
    ├── main.jsx            # Entry point React DOM
    ├── App.jsx             # Gom toàn bộ các layout và section theo thứ tự chuẩn
    ├── index.css           # Cấu hình Tailwind directives & custom utilities
    ├── hooks/
    │   ├── useScrollSpy.js       # Tự động bắt section đang xem để active link trên Navbar
    │   └── useScrollDirection.js # Nhận diện hướng cuộn để ẩn/hiện Floating Dock thông minh
    ├── data/
    │   ├── menuItems.js    # Dữ liệu món ăn nổi bật (Highlight Bento) + danh mục phụ
    │   ├── reviews.js      # Đánh giá khách hàng & điểm rating 4.8⭐
    │   └── gallery.js      # Danh sách ảnh không gian chia theo 'family' & 'outdoor'
    └── components/
        ├── layout/
        │   ├── Navbar.jsx              # Thanh menu cố định, scroll-spy, drawer di động
        │   ├── Footer.jsx              # Thông tin quán, giờ mở cửa, hotline, liên kết
        │   └── FloatingActionDock.jsx  # Thanh hành động đáy màn hình (gọi, zalo, đặt bàn)
        ├── sections/
        │   ├── Hero.jsx                # Banner đầu trang, Ken Burns zoom, badge giờ mở cửa
        │   ├── PromoBanners.jsx        # Carousel khuyến mãi tự động trượt, có Lightbox
        │   ├── HighlightMenu.jsx       # Bento Grid 6 món signature, popup chi tiết món
        │   ├── FullMenu.jsx            # Thực đơn đầy đủ fetch từ menu.json, tab filter, popup
        │   ├── AmbianceSpaces.jsx      # Không gian quán theo tab (Gia Đình / Ngoài Trời), Lightbox
        │   ├── SocialProof.jsx         # Đánh giá Google, số đếm rating động (Counter)
        │   └── LocationContact.jsx     # Google Maps nhúng iframe + bảng thông tin liên hệ
        └── ui/
            ├── DishDetailModal.jsx     # Popup xem chi tiết món ăn khi nhấp vào bất kỳ món nào
            ├── MenuCard.jsx            # Card món ăn mục Highlight
            ├── ReviewCard.jsx          # Card đánh giá khách hàng
            └── SectionHeading.jsx      # Tiêu đề chuẩn hoá cho các section
```

